# 智谱 AI 开放平台 API Key，获取地址：https://open.bigmodel.cn/usercenter/apikeys
ZHIPU_API_KEY=

# 可选：覆盖默认模型
# ZHIPU_CHAT_MODEL=glm-4-flash
# ZHIPU_EMBEDDING_MODEL=embedding-3
# ZHIPU_EMBEDDING_DIM=1024

# === bilibili-catalog-fallback feature ===

# B 站合集 id（合集 URL 里的 collection id），不配置则跳过 catalog 加载
BILI_COLLECTION_ID=

# 百度智能云 OCR（general_basic）
# 控制台：https://console.bce.baidu.com/ai/#/ai/ocr/overview/index
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=

# N6 Layer 2（LLM intro 兜底）confidence 阈值，低于则视同 no_match
# N6_LLM_CONFIDENCE_THRESHOLD=0.7

